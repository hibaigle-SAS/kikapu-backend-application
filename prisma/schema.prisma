generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id String @id @unique @default(uuid())

  fullName      String?  @map("full_name")
  emailAddress  String?  @unique @map("email_address")
  otpVerified   Boolean  @default(false) @map("otp_verified")
  gender        Genders?
  countryCode   String?  @map("country_code")
  birthDate     String?  @map("birth_date")
  idCard        String?  @map("id_card")
  address       String?  @map("address")
  phone         String?
  password      String?
  isDeactivated Boolean  @default(false) @map("is_deactivated")

  role   Roles?  @relation("userRoles", fields: [roleId], references: [id], onDelete: Cascade)
  roleId String? @map("role_id")

  createdById String? @map("created_by_id")
  createdBy   Users?  @relation("createdBy", fields: [createdById], references: [id], onDelete: Cascade)

  users                  Users[]           @relation("createdBy")
  rolePermissions        RolePermissions[]
  createdRoles           Roles[]           @relation("createdRoles")
  permissions            Permissions[]
  userPermissions        UserPermissions[] @relation("userPermissions")
  userPermissionsCreated UserPermissions[] @relation("userPermissionsCreated")
  currencies             Currencies[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  professions  Professions[] @relation("createdProfession")
  profession   Professions?  @relation(fields: [professionId], references: [id], onDelete: Cascade)
  professionId String?       @map("permission_id")

  userType   UserTypes? @relation(fields: [userTypeId], references: [id], onDelete: Cascade)
  userTypeId String?    @map("user_type_id")

  createdUserTypes   UserTypes[]          @relation("createdUserTypes")
  companyTypes       CompanyTypes[]
  companies          Companies[]          @relation("createdCompanies")
  companiesOwned     Companies[]          @relation("companyOwners")
  assetTypes         AssetTypes[]
  companyEvaluations CompanyEvaluations[]
  actionTypes        ActionTypes[]
  actionCategories   ActionCategories[]
  actions            Actions[]

  @@unique([countryCode, phone])
  @@map("users")
}

model Professions {
  id String @id @default(uuid())

  users Users[]

  createdBy   Users?  @relation("createdProfession", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  name String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("professions")
}

model UserTypes {
  id String @id @default(uuid())

  users Users[]

  createdBy   Users?  @relation("createdUserTypes", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  name String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_types")
}

model CompanyTypes {
  id   String  @id @default(uuid())
  name String?

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  companies Companies[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_types")
}

model Roles {
  id              String            @id @default(uuid())
  name            String            @unique
  code            String            @unique
  users           Users[]           @relation("userRoles")
  rolePermissions RolePermissions[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy   Users?  @relation("createdRoles", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  @@map("roles")
}

model Permissions {
  id   String @id @default(uuid())
  name String @unique
  code String @unique

  permissionRoles RolePermissions[]
  userPermissions UserPermissions[]

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model UserPermissions {
  permissionId String      @map("permission_id")
  permission   Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  user   Users  @relation("userPermissions", fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  createdBy   Users  @relation("userPermissionsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model RolePermissions {
  roleId       String      @map("role_id")
  permissionId String      @map("permission_id")
  permission   Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OtpCodes {
  id           String   @id @default(uuid())
  code         String   @unique
  isVerified   Boolean  @default(false) @map("is_verified")
  countryCode  String?  @map("country_code")
  phone        String?
  emailAddress String?  @unique @map("email_address")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([countryCode, phone])
  @@map("otp_codes")
}

enum Genders {
  MALE   @map("male")
  FEMALE @map("female")
}

model Currencies {
  id       String @id @default(uuid())
  name     String @unique
  accronym String @unique

  companyHasAssetsTypeDetails CompanyHasAssetsTypeDetails[]
  companyEvaluations          CompanyEvaluations[]

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("currencies")
}

model Companies {
  id                          String    @id @default(uuid())
  rccm                        String?   @unique
  idNat                       String?   @unique @map("id_nat")
  numeroImpot                 String?   @unique @map("numero_impot")
  creationDate                DateTime? @map("creation_date")
  lastThreeYearsFinanceReport String?   @map("last_three_years_finance_report")
  numberOfEmployees           Int?      @default(0) @map("number_of_employees")
  revenue                     Decimal? // Revenue 
  incomeStatement             String?   @map("income_statement") // Compte des resultats
  shareCapital                Decimal?  @map("share_capital") // Capital social
  initialOutcome              Decimal?  @map("initial_outcome") // Bilan Initial 
  actionCount                 Int?      @map("actions_number") // Nombre d'action

  companyHasAssetsTypes CompanyHasAssetsTypes[]
  companyEvaluations    CompanyEvaluations[]

  createdBy   Users?  @relation("createdCompanies", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  owner   Users?  @relation("companyOwners", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String? @map("owner_id")

  companyType   CompanyTypes? @relation(fields: [companyTypeId], references: [id], onDelete: Cascade)
  companyTypeId String?       @map("company_type_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model CompanyHasAssetsTypes {
  id String @id @default(uuid())

  company   Companies? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?    @map("company_id")

  assetType   AssetTypes? @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  assetTypeId String?     @map("asset_type_id")

  details CompanyHasAssetsTypeDetails[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_has_assets_types")
}

model CompanyHasAssetsTypeDetails {
  id String @id @default(uuid())

  name            String
  quantity        Float?
  amount          Decimal?
  acquisitionDate DateTime? @map("acquisition_date")

  currency   Currencies? @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  currencyId String?     @map("currency_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companyHasAssetsTypes   CompanyHasAssetsTypes? @relation(fields: [companyHasAssetsTypesId], references: [id], onDelete: Cascade)
  companyHasAssetsTypesId String?

  @@map("company_has_assets_type_details")
}

model AssetTypes {
  id   String @id @default(uuid())
  name String @unique

  companyHasAssetsTypes CompanyHasAssetsTypes[]

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("asset_types")
}

model CompanyEvaluations {
  id String @id @default(uuid())

  validated       Boolean @default(false)
  companyNetWorth Decimal @map("company_net_worth")
  reason          String?

  validatedBy   Users?  @relation(fields: [validatedById], references: [id], onDelete: Cascade)
  validatedById String? @map("validate_by_id")

  company   Companies? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?    @map("company_id")

  currency   Currencies? @relation(fields: [currencyId], references: [id])
  currencyId String?     @map("currency_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_evaluations")
}

model ActionTypes {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  actions Actions[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("action_types")
}

model ActionCategories {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  actions Actions[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("action_categories")
}

model Actions {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  createdBy   Users?  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String? @map("created_by_id")

  actionCategory   ActionCategories? @relation(fields: [actionCategoryId], references: [id], onDelete: Cascade)
  actionCategoryId String?           @map("action_category_id")

  actionType   ActionTypes? @relation(fields: [actionTypeId], references: [id], onDelete: Cascade)
  actionTypeId String?      @map("action_type_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("actions")
}
